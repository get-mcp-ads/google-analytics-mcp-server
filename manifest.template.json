{
  "manifest_version": "0.3",
  "name": "google-analytics-mcp-server",
  "display_name": "Google Analytics 4 by getmcpads",
  "version": "2.1.1",
  "description": "Google Analytics 4 MCP server: 27 read tools, no write tools.",
  "author": {
    "name": "getmcpads",
    "url": "https://www.getmcpads.com"
  },
  "homepage": "https://www.getmcpads.com/tools/ga4",
  "documentation": "https://github.com/get-mcp-ads/google-analytics-mcp-server#readme",
  "support": "https://github.com/get-mcp-ads/google-analytics-mcp-server/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/get-mcp-ads/google-analytics-mcp-server"
  },
  "icon": "icon.png",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/cli.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/cli.js"
      ],
      "env": {
        "GA4_CLIENT_ID": "${user_config.ga4_client_id}",
        "GA4_CLIENT_SECRET": "${user_config.ga4_client_secret}",
        "GA4_REFRESH_TOKEN": "${user_config.ga4_refresh_token}",
        "GA4_PROPERTY_ID": "${user_config.ga4_property_id}",
        "GA4_PROPERTY_IDS": "${user_config.ga4_property_ids}"
      }
    }
  },
  "user_config": {
    "ga4_client_id": {
      "type": "string",
      "title": "Ga4 Client Id",
      "description": "OAuth client ID.",
      "required": true,
      "sensitive": false
    },
    "ga4_client_secret": {
      "type": "string",
      "title": "Ga4 Client Secret",
      "description": "OAuth client secret.",
      "required": true,
      "sensitive": true
    },
    "ga4_refresh_token": {
      "type": "string",
      "title": "Ga4 Refresh Token",
      "description": "OAuth refresh token, analytics.readonly scope.",
      "required": true,
      "sensitive": true
    },
    "ga4_property_id": {
      "type": "string",
      "title": "Ga4 Property Id",
      "description": "Default GA4 property ID.",
      "required": false,
      "sensitive": false,
      "default": ""
    },
    "ga4_property_ids": {
      "type": "string",
      "title": "GA4 Property Ids",
      "description": "Comma-separated property IDs every tool is limited to. Recommended; required in 3.0.0.",
      "required": false,
      "sensitive": false,
      "default": ""
    }
  },
  "tools_generated": true,
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
    }
  }
}
